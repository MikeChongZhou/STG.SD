<Window x:Class="ScreenTimeGuardian.TrackingForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTimeGuardian"
        Title="STG OpenRouter Tracking" Width="1080" Height="700" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="18,12,18,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="2,0,2,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="OpenRouter Tracking" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ExportButton" Content="Export CSV" Click="Export_Click" MinHeight="34" MinWidth="88" Padding="13,6"/>
                <Button Content="Close" Click="Close_Click" MinHeight="34" MinWidth="68" Padding="13,6" Margin="0"/>
            </StackPanel>
        </Grid>
        <TabControl x:Name="TrackingTabs" Grid.Row="1" SelectedIndex="1" SelectionChanged="TrackingTabs_SelectionChanged">
            <TabItem Header="Top 20 Since Date">
                <Grid Margin="5,8,5,5">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <Button x:Name="StartDateButton" Click="StartDate_Click" MinHeight="30" MinWidth="112" Padding="10,4" Margin="0"/>
                        <Popup x:Name="StartDatePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=StartDateButton}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="5"><Calendar x:Name="StartCalendar" SelectionMode="SingleDate" SelectedDatesChanged="StartCalendar_Changed"/></Border>
                        </Popup>
                        <TextBlock Text="through latest completed UTC day" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" MinHeight="30" MinWidth="74" Padding="11,4" Margin="0"/>
                    </StackPanel>
                    <DataGrid x:Name="RankingGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" FrozenColumnCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Sorting="Grid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" SortMemberPath="Rank" Width="54"/>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" SortMemberPath="Model" Width="250" MinWidth="190"/>
                            <DataGridTextColumn Header="Input tokens" Binding="{Binding PromptTokens, StringFormat=N0}" SortMemberPath="PromptTokens" Width="135"/>
                            <DataGridTextColumn Header="Output tokens" Binding="{Binding CompletionTokens, StringFormat=N0}" SortMemberPath="CompletionTokens" Width="135"/>
                            <DataGridTextColumn Header="Total tokens" Binding="{Binding TotalTokens, StringFormat=N0}" SortMemberPath="TotalTokens" Width="140"/>
                            <DataGridTextColumn Header="Input $/M" Binding="{Binding PromptPricePerMillion, StringFormat='{}{0:$#,##0.####}'}" SortMemberPath="PromptPricePerMillion" Width="102"/>
                            <DataGridTextColumn Header="Output $/M" Binding="{Binding CompletionPricePerMillion, StringFormat='{}{0:$#,##0.####}'}" SortMemberPath="CompletionPricePerMillion" Width="108"/>
                            <DataGridTextColumn Header="Estimated Revenue" Binding="{Binding RevenueUSD, StringFormat='{}{0:$#,##0}'}" SortMemberPath="RevenueUSD" Width="142"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Weekly Trends">
                <Grid Margin="5,8,5,5">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Value" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="MetricBox" Width="165" MinHeight="30" Height="30" SelectionChanged="Metric_Changed"/>
                        <TextBlock Text="Updated by the weekly action in incremental sync" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both"><local:WeeklyTrackingChartControl x:Name="WeeklyChart" MinWidth="920" MinHeight="430"/></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusLabel" Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="3,7,0,0" FontSize="12"/>
    </Grid>
</Window>
