<Window x:Class="ScreenTimeGuardian.OneDriveAuthorizationForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Microsoft OneDrive" Width="620" Height="440" MinWidth="500" MinHeight="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="30,26,30,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Connect OneDrive" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="1" Margin="0,9,0,16" TextWrapping="Wrap" LineHeight="22" Text="Your browser has been opened. Sign in to Microsoft, enter this code if requested, and approve Screen Time Guardian. This window will close automatically when authorization finishes."/>
        <Border Grid.Row="2" Background="{StaticResource AccentSoftBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CodeLabel" FontFamily="Cascadia Mono, Consolas" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Copy code" Click="Copy_Click" Margin="14,0,0,0"/></Grid></Border>
        <TextBlock x:Name="StatusLabel" Grid.Row="3" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal"><Button Content="Open browser again" Click="Browser_Click"/><Button Content="Cancel" Click="Cancel_Click" Margin="0"/></StackPanel>
    </Grid>
</Window>
