<Window x:Class="ScreenTimeGuardian.OnboardingForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Up Screen Time Guardian" Width="680" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Set Up Screen Time Guardian" Style="{StaticResource PageTitle}"/><TextBlock x:Name="StepLabel" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,22">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleLabel" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailLabel" FontSize="16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,22"/>
                <CheckBox x:Name="StartupBox" Content="Launch Screen Time Guardian when I sign in to Windows" FontSize="16" Visibility="Collapsed"/>
                <StackPanel x:Name="CloudButtons" Orientation="Horizontal">
                    <Button Content="Set Up Private Cloud" Click="ConfigureCloud_Click" MinWidth="170"/>
                    <Button Content="Not Now" Click="SkipCloud_Click" MinWidth="100" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BackButton" Content="Back" Click="Back_Click" Visibility="Collapsed"/>
            <Button x:Name="FinishButton" Content="Finish" Click="Finish_Click" Visibility="Collapsed" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
