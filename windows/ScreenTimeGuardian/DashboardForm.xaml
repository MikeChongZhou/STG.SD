<Window x:Class="ScreenTimeGuardian.DashboardForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Time Guardian" Width="760" Height="560" MinWidth="680" MinHeight="460" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both" CanContentScroll="False">
        <Grid Margin="24" MinWidth="620">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <TextBlock Text="Screen Time Guardian" Style="{StaticResource PageTitle}" FontSize="34" HorizontalAlignment="Center" Margin="0,4,0,22"/>

            <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,-14,-14">
                <Button Click="Report_Click" Margin="0,0,14,14" Padding="18" MinHeight="136" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Report" FontWeight="SemiBold" FontSize="20"/><TextBlock Margin="0,11,0,0" FontSize="15"><Run Text="All Devices: "/><Run x:Name="AllValue" FontWeight="SemiBold"/></TextBlock><TextBlock Margin="0,5,0,0" FontSize="15"><Run Text="This PC: "/><Run x:Name="LocalValue" FontWeight="SemiBold"/></TextBlock></StackPanel>
                    </Grid>
                </Button>
                <Button Click="Tracking_Click" Margin="0,0,14,14" Padding="18" MinHeight="136" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Tracking" FontWeight="SemiBold" FontSize="20"/><TextBlock Text="Latest week · Top models" Margin="0,11,0,0"/><TextBlock x:Name="TrackingSummary" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                </Button>
                <Button Click="Settings_Click" Margin="0,0,14,14" Padding="18" MinHeight="136" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Settings" FontWeight="SemiBold" FontSize="20"/><TextBlock Margin="0,11,0,0" FontSize="15"><Run Text="Daily Limit: "/><Run x:Name="PlanValue" FontWeight="SemiBold"/></TextBlock><TextBlock Margin="0,5,0,0" FontSize="15"><Run x:Name="MeetingModeLabel" Text="Meeting Mode: "/><Run x:Name="MeetingModeValue" FontWeight="SemiBold"/></TextBlock></StackPanel>
                    </Grid>
                </Button>
                <Button Click="About_Click" Margin="0,0,14,14" Padding="18" MinHeight="136" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="About" FontWeight="SemiBold" FontSize="20"/><TextBlock Text="Version 1.1.8" Margin="0,11,0,0"/><TextBlock Text="Local + private cloud" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="2,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#22A06B" Margin="0,0,8,0"/><TextBlock x:Name="SyncStatusLabel" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0"><Button Content="Sync Now" Style="{StaticResource PrimaryButton}" Click="Sync_Click"/><Button Content="Close Window" Click="CloseWindow_Click" Margin="0"/></StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
