<Window x:Class="ScreenTimeGuardian.CloudSetupForm" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configure Private Cloud" Width="620" Height="590" MinWidth="540" MinHeight="500" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
      <TextBlock Text="Configure private cloud" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Which devices will share this data?" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <CheckBox Content="This Windows PC" IsChecked="True" IsEnabled="False"/><CheckBox x:Name="IosBox" Content="iPhone / iPad"/><CheckBox x:Name="MacBox" Content="Mac"/><CheckBox x:Name="AndroidBox" Content="Android"/>
      <CheckBox x:Name="ChinaBox" Content="I need this to work while travelling in mainland China" Margin="0,14,0,0" Checked="Choice_Changed" Unchecked="Choice_Changed"/>
      <Border Style="{StaticResource Card}" Margin="0,18,0,12"><StackPanel><TextBlock Text="RECOMMENDATION" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RecommendationLabel" FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
      <TextBlock Text="Provider" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="ProviderBox" Width="260" HorizontalAlignment="Left" SelectionChanged="Provider_Changed"/>
      <TextBlock x:Name="AccountLabel" Margin="0,15,0,8" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ConnectButton" Content="Connect account…" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/><Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click"/></WrapPanel>
      <TextBlock x:Name="StatusLabel" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
  </DockPanel>
</Window>
