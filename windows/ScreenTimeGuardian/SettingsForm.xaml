<Window x:Class="ScreenTimeGuardian.SettingsForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Time Guardian Settings" Width="900" Height="620" MinWidth="700" MinHeight="470" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="24,16,18,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SaveButton" Content="Save" Click="Save_Click" MinHeight="34" MinWidth="68" Padding="13,6" IsEnabled="False"/>
                <Button Content="Close" Click="Close_Click" MinHeight="34" MinWidth="68" Padding="13,6" Margin="0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both" CanContentScroll="False">
            <StackPanel Margin="24,4,18,20" MinWidth="650">
                <TextBlock Text="PRIVATE CLOUD" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Current cloud" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Width="430" Margin="0,0,14,8" VerticalAlignment="Center"><TextBlock x:Name="ProviderLabel" FontWeight="SemiBold"/><TextBlock x:Name="AccountLabel" TextWrapping="Wrap"/><TextBlock x:Name="CloudStatusLabel" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                            <Button Content="Configure…" Style="{StaticResource PrimaryButton}" Click="ConfigureCloud_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GENERAL" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Daily Limit" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="PlanHourBox" Width="76"/><TextBlock Text="h" Margin="7,0,12,0" VerticalAlignment="Center"/><ComboBox x:Name="PlanMinuteBox" Width="76"/><TextBlock Text="m" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                <CheckBox x:Name="StartupBox" Grid.Row="1" Grid.ColumnSpan="2" Content="Launch at Windows sign-in" Margin="0,20,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="REMINDERS" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <UniformGrid Columns="3" Margin="0,0,-10,0">
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Eye close delay" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><ComboBox x:Name="EyeCountdownBox" Width="68"/><TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Posture delay" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><ComboBox x:Name="PostureCountdownBox" Width="68"/><TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Daily-limit delay" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><ComboBox x:Name="DailyCountdownBox" Width="68"/><TextBlock Text="min" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
                                </UniformGrid>
                                <Separator Margin="0,16"/>
                                <CheckBox x:Name="MeetingModeBox" Content="Manual meeting mode — silent and immediately closeable"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionTitle}" Margin="2,18,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Export the app database, global settings, or diagnostic events." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0"><Button Content="Export Data…" Click="ExportData_Click"/><Button Content="Export Test Log…" Click="ExportLog_Click" Margin="8,0,0,0"/></StackPanel></Grid></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
