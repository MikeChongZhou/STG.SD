<Window x:Class="ScreenTimeGuardian.AboutForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Screen Time Guardian" Width="660" Height="580" MinWidth="500" MinHeight="400" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="28,24,24,24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Export test log" Click="Export_Click"/><Button Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click" Margin="0"/></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><StackPanel Margin="0,0,8,0">
            <TextBlock Text="Screen Time Guardian" Style="{StaticResource PageTitle}"/><TextBlock Text="Version 1.1.6  ·  TimberTrail" Foreground="{StaticResource AccentBrush}" Margin="1,5,0,24"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><TextBlock TextWrapping="Wrap" LineHeight="24" Text="Use your private cloud to combine screen-time estimates across devices. Every device should connect to the same OneDrive or Google Drive account."/></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><TextBlock TextWrapping="Wrap" LineHeight="24" Text="Your data remains on this PC and in the private cloud account you authorize. It is not uploaded to the app developer. STG requests only each provider’s private application-data area."/></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><TextBlock TextWrapping="Wrap" LineHeight="24" Text="STG suggests an eye break after each 20-minute active block, alternates posture reminders when due, and reminds you after the combined daily plan is exceeded. Meeting detection makes a reminder silent and immediately closeable."/></Border>
            <Border Style="{StaticResource Card}" Margin="0"><TextBlock TextWrapping="Wrap" LineHeight="24" Text="Open-source claim: this application uses SQLite and the .NET runtime. Their license notices are preserved with the project; STG does not claim ownership of those components."/></Border>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
