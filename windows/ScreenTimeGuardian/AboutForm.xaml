<Window x:Class="ScreenTimeGuardian.AboutForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Screen Time Guardian" Width="740" Height="600" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="28,22,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Screen Time Guardian" Style="{StaticResource PageTitle}"/><TextBlock Text="Version 1.1.9" Foreground="{StaticResource AccentBrush}" Margin="1,5,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click" MinHeight="34" MinWidth="68" Padding="13,6" Margin="18,0,0,0" VerticalAlignment="Top"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
            <StackPanel Margin="1,2,10,0">
                <TextBlock Text="Copyright © 2026 Fairy Phoenix Foundation." TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"/>
                <TextBlock Text="This app records minute-level estimates of screen use, either on this PC alone or across your devices, and reminds you to take breaks." TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"/>
                <TextBlock TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"><Run Text="Privacy: " FontWeight="SemiBold"/><Run Text="Your screen-use data remains on this PC and, if enabled, in your chosen private-cloud account. STG does not send it to the developer or anyone else."/></TextBlock>
                <TextBlock TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"><Run Text="Accuracy: " FontWeight="SemiBold"/><Run Text="STG estimates screen use from Windows activity signals, so its totals may differ from other system usage statistics."/></TextBlock>
                <TextBlock Text="Third-Party Software Acknowledgments" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,8"/>
                <TextBlock Text="This app includes SQLite and open-source components from Microsoft .NET. Their original copyright notices and license terms are preserved. All rights remain with their respective owners. STG claims no ownership of these components." TextWrapping="Wrap" LineHeight="23"/>
                <WrapPanel Margin="0,12,0,0"><TextBlock Margin="0,0,18,8"><Hyperlink NavigateUri="https://github.com/dotnet/runtime/blob/main/LICENSE.TXT" RequestNavigate="OpenSourceLicenses_RequestNavigate">Microsoft .NET license</Hyperlink></TextBlock><TextBlock Margin="0,0,0,8"><Hyperlink NavigateUri="https://www.sqlite.org/copyright.html" RequestNavigate="OpenSourceLicenses_RequestNavigate">SQLite copyright and public-domain notice</Hyperlink></TextBlock></WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
