<Window x:Class="ScreenTimeGuardian.AboutForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Screen Time Guardian" Width="740" Height="600" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="28,22,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Screen Time Guardian" Style="{StaticResource PageTitle}"/><TextBlock Text="Version 1.2.26" Foreground="{StaticResource AccentBrush}" Margin="1,5,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click" MinHeight="34" MinWidth="68" Padding="13,6" Margin="18,0,0,0" VerticalAlignment="Top"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
            <StackPanel Margin="1,2,10,0">
                <TextBlock Text="Copyright © 2026 Fairy Phoenix Foundation." TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"/>
                <TextBlock Text="Track screen use across your devices and get break reminders." TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"/>
                <TextBlock TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"><Run Text="Privacy: " FontWeight="SemiBold"/><Run Text="Data stays on your devices and, if you enable sync, in your own cloud account. It is not sent to the developer."/></TextBlock>
                <TextBlock TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,16"><Run Text="Accuracy: " FontWeight="SemiBold"/><Run Text="PC usage is estimated from activity signals and may differ from system statistics."/></TextBlock>
                <TextBlock Text="Third-Party Software Acknowledgments" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,8"/>
                <TextBlock Text="Uses SQLite and Microsoft .NET open-source components. See their licenses below." TextWrapping="Wrap" LineHeight="23"/>
                <WrapPanel Margin="0,12,0,0"><TextBlock Margin="0,0,18,8"><Hyperlink NavigateUri="https://github.com/dotnet/runtime/blob/main/LICENSE.TXT" RequestNavigate="OpenSourceLicenses_RequestNavigate">Microsoft .NET license</Hyperlink></TextBlock><TextBlock Margin="0,0,0,8"><Hyperlink NavigateUri="https://www.sqlite.org/copyright.html" RequestNavigate="OpenSourceLicenses_RequestNavigate">SQLite copyright and public-domain notice</Hyperlink></TextBlock></WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
