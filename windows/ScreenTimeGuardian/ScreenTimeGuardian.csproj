<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ScreenTimeGuardian</AssemblyName>
    <RootNamespace>ScreenTimeGuardian</RootNamespace>
    <Version>1.1.9</Version>
    <AssemblyVersion>1.1.9</AssemblyVersion>
    <FileVersion>1.1.9</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\stg.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.22" />
    <EmbeddedResource Include="..\..\apple\STGCore\Sources\STGCore\Resources\stg.sqlite">
      <Link>Assets\stg.sqlite</Link>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(STG_GOOGLE_CLIENT_SECRET)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>STGGoogleClientSecret</_Parameter1>
      <_Parameter2>$(STG_GOOGLE_CLIENT_SECRET)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
