<Window x:Class="ScreenTimeGuardian.ReportForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTimeGuardian"
        Title="STG Report" Width="1180" Height="720" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid Margin="18,10,18,8" MinWidth="1040">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Screen Time Report" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            <UniformGrid Grid.Column="1" Columns="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0" MaxWidth="450">
                <StackPanel Orientation="Horizontal" Margin="8,0"><TextBlock Text="ALL DEVICES  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="AllValue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0"><TextBlock Text="THIS PC  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="LocalValue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0"><TextBlock Text="DAILY LIMIT  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="PlanValue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            </UniformGrid>
            <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Sync Now" Style="{StaticResource PrimaryButton}" Click="Sync_Click" MinWidth="84" MinHeight="34" Padding="13,6"/>
                <Button Content="Export CSV" Click="Export_Click" MinWidth="88" MinHeight="34" Padding="13,6"/>
                <Button Content="Close" Click="Close_Click" MinWidth="68" MinHeight="34" Padding="13,6" Margin="0"/>
            </WrapPanel>
        </Grid>
        </ScrollViewer>
        <TextBlock x:Name="StatisticsSummaryLabel" Grid.Row="1" Margin="24,0,20,7" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        <TabControl x:Name="ReportTabs" Grid.Row="2" Margin="16,0,16,12" SelectionChanged="ReportTabs_SelectionChanged">
            <TabItem Header="Daily">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Report date" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="DailyDateButton" Click="DailyDate_Click" MinHeight="30" MinWidth="112" Padding="10,4" Margin="0"/>
                        <Popup x:Name="DailyDatePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=DailyDateButton}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="5"><Calendar x:Name="DailyCalendar" SelectionMode="SingleDate" SelectedDatesChanged="DailyCalendar_Changed"/></Border>
                        </Popup>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both"><StackPanel x:Name="ReportCards" MinWidth="980" Margin="0,2,8,0"/></ScrollViewer>
                    <TextBlock x:Name="StatusLabel" Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,5,0,0" FontSize="12"/>
                </Grid>
            </TabItem>
            <TabItem Header="Multiple Days">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="StartDateButton" Click="StartDate_Click" MinHeight="30" MinWidth="112" Padding="10,4" Margin="0"/>
                        <Popup x:Name="StartDatePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=StartDateButton}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="5"><Calendar x:Name="StartCalendar" SelectionMode="SingleDate" SelectedDatesChanged="StartCalendar_Changed"/></Border>
                        </Popup>
                        <TextBlock Text="End" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <Button x:Name="EndDateButton" Click="EndDate_Click" MinHeight="30" MinWidth="112" Padding="10,4" Margin="0"/>
                        <Popup x:Name="EndDatePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=EndDateButton}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="5"><Calendar x:Name="EndCalendar" SelectionMode="SingleDate" SelectedDatesChanged="EndCalendar_Changed"/></Border>
                        </Popup>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both"><local:UsageLineChartControl x:Name="UsageChart" MinWidth="980" MinHeight="390"/></ScrollViewer>
                    </Border>
                    <TextBlock x:Name="RangeStatusLabel" Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,7,0,0" FontSize="12"/>
                </Grid>
            </TabItem>
            <TabItem Header="Year by Week">
                <Grid Margin="4,8,4,4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8" Margin="0"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><local:UsageLineChartControl x:Name="YearChart" MinWidth="980" MinHeight="390"/></ScrollViewer></Border>
                    <TextBlock TextWrapping="Wrap" MaxHeight="100" x:Name="YearStatusLabel" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="2,7,0,0" FontSize="12"/>
                </Grid>
            </TabItem>
            <TabItem Header="Years by Month">
                <Grid Margin="4,8,4,4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8" Margin="0"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><local:UsageLineChartControl x:Name="MonthChart" MinWidth="980" MinHeight="390"/></ScrollViewer></Border>
                    <TextBlock TextWrapping="Wrap" MaxHeight="100" x:Name="MonthStatusLabel" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="2,7,0,0" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
