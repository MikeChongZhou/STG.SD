<Window x:Class="ScreenTimeGuardian.ReportForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTimeGuardian"
        Title="STG Report" Width="1040" Height="690" MinWidth="720" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid Margin="18,10,18,8" MinWidth="900">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Screen Time Report" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
            <UniformGrid Grid.Column="1" Columns="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0" MaxWidth="450">
                <StackPanel Orientation="Horizontal" Margin="8,0"><TextBlock Text="ALL DEVICES  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="AllValue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0"><TextBlock Text="THIS PC  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="LocalValue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0"><TextBlock Text="PLAN  " Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><TextBlock x:Name="PlanValue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            </UniformGrid>
            <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Sync now" Style="{StaticResource PrimaryButton}" Click="Sync_Click" MinWidth="84" MinHeight="34" Padding="13,6"/>
                <Button Content="Export CSV" Click="Export_Click" MinWidth="88" MinHeight="34" Padding="13,6"/>
                <Button Content="Close" Click="Close_Click" MinWidth="68" MinHeight="34" Padding="13,6" Margin="0"/>
            </WrapPanel>
        </Grid>
        </ScrollViewer>
        <TabControl x:Name="ReportTabs" Grid.Row="1" Margin="16,0,16,12" SelectionChanged="ReportTabs_SelectionChanged">
            <TabItem Header="Daily report">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Report date" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="DailyDatePicker" Width="132" MinHeight="27" Height="27" SelectedDateChanged="DailyDate_Changed"/>
                        <Button Content="Today" Click="Today_Click" MinHeight="27" MinWidth="60" Padding="9,3"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PanningMode="Both"><StackPanel x:Name="ReportCards" MinWidth="650" Margin="0,2,8,0"/></ScrollViewer>
                    <TextBlock x:Name="StatusLabel" Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,5,0,0" FontSize="12"/>
                </Grid>
            </TabItem>
            <TabItem Header="Multiple days">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="StartDatePicker" Width="145" MinHeight="30" Height="30"/>
                        <TextBlock Text="End" VerticalAlignment="Center" Margin="12,0,6,0"/><DatePicker x:Name="EndDatePicker" Width="145" MinHeight="30" Height="30"/>
                        <Button Content="Show range" Style="{StaticResource PrimaryButton}" Click="Range_Click" Margin="12,0,0,0" MinHeight="30" MinWidth="86" Padding="11,4"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both"><local:UsageLineChartControl x:Name="UsageChart" MinWidth="760" MinHeight="390"/></ScrollViewer>
                    </Border>
                    <TextBlock x:Name="RangeStatusLabel" Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,7,0,0" FontSize="12"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
