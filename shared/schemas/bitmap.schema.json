{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STG UTC minute bitmap",
  "type": "object",
  "required": ["device_id", "utc_date", "bitmap_base64", "updated_at", "reserved"],
  "properties": {
    "device_id": { "type": "string", "minLength": 1 },
    "utc_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "bitmap_base64": { "type": "string", "contentEncoding": "base64" },
    "updated_at": { "type": "string", "format": "date-time" },
    "reserved": { "type": "object" }
  },
  "additionalProperties": true
}

